#include <Xc.h>
#include <pic18F4550.h>
void main() {
    TRISD = 0x00;    
    LATD  = 0x00;

    while(1){
        LATDbits.LATD0 = 1;
        delay_ms(500);

        LATDbits.LATD0 = 0;
        delay_ms(500);
    }
}

void delay_ms(unsigned int ms)
{
    unsigned int i, j;
    for(i = 0; i < ms; i++){
        for(j = 0; j < 1000; j++);
    }
}
